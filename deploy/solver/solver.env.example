# /etc/openswap/solver.env (root:openswap, 0640). No secrets here: the key is
# /etc/openswap/testnet-solver-key (root, 0600), passed in by LoadCredential.

# Extra service options (see scripts/solver-service.ts). Defaults: every 15 s,
# 500 CKB balance floor, 0.5 CKB fee budget per rolling 24 h.
SOLVER_ARGS=--interval=15 --min-balance=500 --daily-fee-budget=0.5

# CKB testnet RPC. Default https://testnet.ckb.dev.
#CKB_RPC_URL=https://testnet.ckb.dev

# Optional dead-man pings from the health timer (e.g. healthchecks.io). Unset = no pings.
#OPENSWAP_HEALTH_PING_URL=https://hc-ping.com/<uuid>
#OPENSWAP_HEALTH_FAIL_URL=https://hc-ping.com/<uuid>/fail
